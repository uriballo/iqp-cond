# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Environments
.venv/
venv/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.hypothesis/

# Notebooks
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# OS files
.DS_Store

# Disposable scratch work
prototypes/

# Local benchmarks and documentation
/benchmarks/
# Include the conditional pipeline source and docs; keep generated outputs local.
!/benchmarks/
/benchmarks/*
!/benchmarks/__init__.py
!/benchmarks/README.md
!/benchmarks/conditional_pipeline/
!/benchmarks/conditional_pipeline/**
benchmarks/conditional_pipeline/**/__pycache__/
benchmarks/conditional_pipeline/results/
benchmarks/conditional_pipeline/*.jsonl
benchmarks/conditional_pipeline/*.json
/docs/
CONTEXT.md
